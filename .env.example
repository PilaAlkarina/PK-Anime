# List sync sign-in (Better Auth): MyAnimeList, AniList or both. Copy to .env.local.
BETTER_AUTH_SECRET=
# On a local network, the address the TV and phones use, e.g. http://192.168.1.50:3000
BETTER_AUTH_URL=http://localhost:3000
# https://myanimelist.net/apiconfig, redirect URL {BETTER_AUTH_URL}/api/auth/callback/myanimelist
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
# https://anilist.co/settings/developer, redirect URL {BETTER_AUTH_URL}/api/auth/callback/anilist
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# Control panel of npm run serve (see "Control panel" in the README). Off while the password is empty
PANEL_PASSWORD=
# PANEL_PORT=3001
# Panel under a path of the site's own port, the rest going on to the app (npm run serve -- -p 3000):
# PANEL_PORT=80
# PANEL_PATH=/admin
