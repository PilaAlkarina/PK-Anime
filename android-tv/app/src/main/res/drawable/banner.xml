<?xml version="1.0" encoding="utf-8"?>
<!-- The tile in the Fire TV / Android TV launcher: 320 × 180 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <solid android:color="#0C0B10" />
        </shape>
    </item>
    <item android:top="164dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF4A2E" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/logo"
        android:left="100dp"
        android:right="100dp"
        android:top="38dp"
        android:bottom="54dp" />
</layer-list>
